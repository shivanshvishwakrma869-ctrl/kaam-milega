# =============================================================================
# KaamMilega — environment template
#
# Copy to `.env.local` for local development, and set the same keys in
# Netlify under Site settings > Environment variables.
#
# IMPORTANT: a Firebase *web* config is not a secret. These values ship in
# every client bundle by design and are safe to expose. What protects your
# data is Firestore Security Rules (firebase/firestore.rules) plus App Check —
# not hiding these strings. Never put a service-account key or the Firebase
# Admin credentials in a VITE_ variable; those belong only in Cloud Functions.
# =============================================================================

# --- Firebase web config (Project settings > General > Your apps) ------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — only needed if you enable Google Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# --- App Check (reCAPTCHA v3 site key) ---------------------------------------
# Register at Firebase console > App Check > Apps > reCAPTCHA v3.
# Without this, App Check is skipped and the `appCheckOk()` condition in
# firestore.rules will reject writes once you enforce it.
VITE_RECAPTCHA_SITE_KEY=

# --- Local development toggles -----------------------------------------------
# Point the SDK at the local emulator suite instead of production.
VITE_USE_EMULATORS=false
# Print an App Check debug token to the console during local dev.
VITE_APPCHECK_DEBUG=false

# Leaving VITE_FIREBASE_API_KEY empty runs the app in DEMO MODE against the
# local seed data in src/data/seed.js — useful for UI work with no backend.
